<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Header Compte (Haut Gauche) -->
    <LinearLayout
        android:id="@+id/btn_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/header_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_person"
            android:background="#33FFFFFF"
            android:scaleType="centerCrop"
            android:contentDescription="Account"/>

        <TextView
            android:id="@+id/header_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Bienvenue Guest"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>
    </LinearLayout>

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:contentDescription="Xbox Logo"
        android:src="@drawable/xbox_aqua" />

    <!-- Button Settings -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/cog" />

    <!-- Custom Settings View -->
    <com.example.xboxcloudviewer.SettingsView
        android:id="@+id/settings_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#DD000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"/>

    <!-- Custom Accounts View -->
    <com.example.xboxcloudviewer.ui.AccountsView
        android:id="@+id/accounts_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#DD000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"/>

    <!-- Custom Profile Edit View -->
    <com.example.xboxcloudviewer.ui.ProfileEditView
        android:id="@+id/profile_edit_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#DD000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"/>

</FrameLayout>
